# Put these in Coolify -> Application -> Environment Variables.
# Placeholder values only; never commit real secrets.

# Domain and Traefik (required)
APP_DOMAIN=app.example.com
TRAEFIK_NETWORK=replace-with-coolify-app-network
APP_NAME=go-project

# PEM keys: multiline or \n-escaped (required)
JWT_PRIVATE_KEY_PEM=...
JWT_PUBLIC_KEY_PEM=...

# Database (required)
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

# OAuth
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Token TTL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Observability and upstreams
# OTLP endpoint for telemetry export (empty disables it).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Required: base URL of the upstream market quotes API (price-service).
SERVICE_HTTP_CLIENTS_MARKET_BASE_URL=
